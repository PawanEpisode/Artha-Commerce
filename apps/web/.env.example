# Copy to .env.local for local dev. In Vercel, add these under Project -> Settings -> Environment Variables.
# Variables prefixed VITE_ are bundled into the browser. Never put secrets behind VITE_.

# Public site
# Origin only (scheme + host, no path). Production: https://arthacommerce.meetpawan.com
VITE_SITE_URL=http://localhost:3000
VITE_SITE_NAME=ArthaCommerce

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API (Django on Vercel)
VITE_API_URL=http://localhost:8000

# PostHog (proxied through /ingest to dodge ad blockers)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=/ingest
VITE_POSTHOG_UI_HOST=https://us.posthog.com

# Web Push (X-01.1). Public key of the VAPID pair: npx --yes web-push generate-vapid-keys --json
# The private key goes to the API only (VAPID_PRIVATE_KEY). Redeploy the web project after changing this value.
VITE_VAPID_PUBLIC_KEY=
# Set to true to register the service worker in `pnpm dev` as well (production builds always register it).
VITE_SW_DEV=

# Sentry (browser DSN is public by design)
VITE_SENTRY_DSN=

# Build-time only (set in Vercel, NOT prefixed VITE_). Enables source map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
