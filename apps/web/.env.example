# Copy to .env.local for local dev. In Vercel, add these under Project -> Settings -> Environment Variables.
# Variables prefixed VITE_ are bundled into the browser. Never put secrets behind VITE_.

# Public site
VITE_SITE_URL=http://localhost:3000
VITE_SITE_NAME=ArthaCommerce

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API (Django on Vercel)
VITE_API_URL=http://localhost:8000

# PostHog (proxied through /ingest to dodge ad blockers)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=/ingest
VITE_POSTHOG_UI_HOST=https://us.posthog.com

# Sentry (browser DSN is public by design)
VITE_SENTRY_DSN=

# Build-time only (set in Vercel, NOT prefixed VITE_). Enables source map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
