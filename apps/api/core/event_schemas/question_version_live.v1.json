{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "question_version_live",
  "type": "object",
  "required": [
    "question_id",
    "version_id",
    "version_no",
    "visibility",
    "ownership",
    "change_kind",
    "kind"
  ],
  "properties": {
    "question_id": { "type": "string", "format": "uuid" },
    "version_id": { "type": "string", "format": "uuid" },
    "version_no": { "type": "integer", "minimum": 1 },
    "visibility": { "type": "string", "enum": ["private", "link", "public"] },
    "ownership": { "type": "string", "enum": ["platform", "user_uploaded", "user_created"] },
    "change_kind": { "type": "string" },
    "chapter_id": { "type": ["string", "null"], "format": "uuid" },
    "kind": { "type": "string" },
    "collection_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
  },
  "additionalProperties": false
}
