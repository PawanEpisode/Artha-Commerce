    "scheme_id": { "type": "string", "format": "uuid" },
    "term_code": { "type": "string" },
    "paper_kind": { "type": "string" },
    "chapter_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "is_limited": { "type": "boolean" },
    "stats_version": { "type": "integer" }
  },
  "additionalProperties": false
}
