{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mock_attempt_completed.v1",
  "type": "object",
  "required": [
    "attempt_id",
    "session_id",
    "paper_id",
    "paper_version_id",
    "source_tag",
    "kind",
    "run_mode",
    "integrity_class",
    "completion",
    "score",
    "max_score",
    "score_status"
  ],
  "properties": {
    "attempt_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string", "format": "uuid" },
    "paper_id": { "type": "string", "format": "uuid" },
    "paper_version_id": { "type": "string", "format": "uuid" },
    "series_id": { "type": ["string", "null"] },
    "source_tag": { "type": "string" },
    "kind": { "type": "string" },
    "run_mode": { "type": "string" },
    "integrity_class": { "type": "string" },
    "completion": { "type": "string" },
    "scheme_id": { "type": ["string", "null"] },
    "subject_key": { "type": ["string", "null"] },
    "tz": { "type": "string" },
    "local_date": { "type": "string" },
    "started_at": { "type": ["string", "null"] },
    "ended_at": { "type": ["string", "null"] },
    "time_used_seconds": { "type": ["integer", "null"] },
    "score": { "type": "number" },
    "max_score": { "type": "number" },
    "score_status": { "type": "string" },
    "comparable_score": { "type": ["number", "null"] },
    "comparable_max": { "type": ["number", "null"] },
    "answer_key_status": { "type": "string" },
    "attempt_no": { "type": "integer" },
    "section_scores": { "type": "array" },
    "by_chapter": { "type": "array" }
  },
  "additionalProperties": false
}
