{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "practice_session_started.v1",
  "type": "object",
  "required": [
    "session_id",
    "mode",
    "origin_module",
    "question_count"
  ],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "mode": { "type": "string" },
    "origin_module": { "type": "string" },
    "origin_ref": { "type": ["string", "null"] },
    "question_count": { "type": "integer", "minimum": 0 },
    "chapter_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "time_limit_seconds": { "type": ["integer", "null"] }
  },
  "additionalProperties": false
}
