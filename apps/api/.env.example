# Copy to .env for local dev (load with your shell or direnv). In Vercel, add under Project -> Settings -> Environment Variables.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Comma separated. Vercel domains are always allowed (.vercel.app).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Content admin (staff only). Use a hard-to-guess path in production.
DJANGO_ADMIN_PATH=admin
# Needed in production for admin login over HTTPS, e.g. https://api.yourdomain.com
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase Postgres. Runtime = transaction pooler (port 6543). Migrations = direct/session connection (port 5432).
DATABASE_URL=
DIRECT_DATABASE_URL=

# Supabase Auth (JWT verification)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Sentry
SENTRY_DSN=

# Supabase service-role key: Storage writes (avatars) and account deletion. API only. Never VITE_*, never committed.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# F-03 notes: shared secret for the cron tick POST/GET /api/v1/notes/internal/tick/ (header X-Notes-Tick-Secret or
# Authorization: Bearer). Use a long random value (openssl rand -hex 32). Vercel Cron sends the Bearer form from the
# CRON_SECRET variable, so set CRON_SECRET to the same value in the API project. Empty means the tick refuses everyone.
NOTES_TICK_SECRET=

# F-03 R2 upload scanning. null = no scan, files are clean at once (development and tests ONLY). clamd = stream every upload to
# ClamAV (the scan runs in the worker as the media.scan job). Set CLAMD_SOCKET for a unix socket, or CLAMD_HOST and CLAMD_PORT.
# clamd.conf needs StreamMaxLength 64M so the largest plan file passes.
MEDIA_SCANNER=null
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_SOCKET=
