# Copy to .env for local dev (load with your shell or direnv). In Vercel, add under Project -> Settings -> Environment Variables.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Comma separated. Vercel domains are always allowed (.vercel.app).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Content admin (staff only). Use a hard-to-guess path in production.
DJANGO_ADMIN_PATH=admin
# Needed in production for admin login over HTTPS, e.g. https://api.yourdomain.com
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase Postgres. Runtime = transaction pooler (port 6543). Migrations = direct/session connection (port 5432).
DATABASE_URL=
DIRECT_DATABASE_URL=

# Supabase Auth (JWT verification)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# F-03 R3 (flag `notes_ai`). EVERY switch fails closed: leave them as they are until you have read docs/F-03-ROLLOUT.md (R3).
# `paid` ONLY when the key's Google Cloud project has an active billing account (Gemini API "Paid Services"). A consumer Gemini or
# Google AI Pro subscription does NOT count.
GEMINI_DATA_TIER=unconfirmed
# The consent version you approved (apps/api/modules/notes/domain/ai_consent.py VERSION). Empty keeps AI off.
NOTES_AI_CONSENT_APPROVED=
NOTES_AI_SUMMARY_ENABLED=true
NOTES_AI_OCR_ENABLED=true
# All students together, India day. 0 keeps AI off.
NOTES_AI_DAILY_BUDGET_PAISE=0
GEMINI_PRICE_IN_PAISE_PER_M=13200
GEMINI_PRICE_OUT_PAISE_PER_M=79200
# Unlock for search: comma separated Fernet keys, newest first. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The API and the worker need the SAME value. Empty keeps the feature off.
NOTES_UNLOCK_FERNET_KEYS=
# Resumable upload of big PDFs (Supabase Storage S3 connection). All empty keeps every upload a single PUT.
NOTES_S3_ENDPOINT=
NOTES_S3_REGION=
NOTES_S3_ACCESS_KEY_ID=
NOTES_S3_SECRET_ACCESS_KEY=

# Sentry
SENTRY_DSN=

# Supabase service-role key: Storage writes (avatars) and account deletion. API only. Never VITE_*, never committed.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# F-03 notes: shared secret for the cron tick POST/GET /api/v1/notes/internal/tick/ (header X-Notes-Tick-Secret or
# Authorization: Bearer). Use a long random value (openssl rand -hex 32). Vercel Cron sends the Bearer form from the
# CRON_SECRET variable, so set CRON_SECRET to the same value in the API project. Empty means the tick refuses everyone.
NOTES_TICK_SECRET=

# F-15 recall. The feature is behind the PostHog flag `recall_system`, which fails closed: off unless PostHog says on.
# RECALL_TICK_SECRET guards the cron tick `/api/v1/recall/internal/tick/` (call it every 5 minutes with the header
# X-Recall-Tick-Secret or `Authorization: Bearer <secret>`; it closes study sessions idle for an hour). Use a long random
# value (it may equal NOTES_TICK_SECRET); empty refuses every caller, and sessions then close only when the student closes them.
RECALL_TICK_SECRET=
# RECALL_PACK_MAX caps how many cards an offline pack may hold, whatever the student's plan allows (default 500).
RECALL_PACK_MAX=500
# RECALL_DEFAULT_WEIGHTS_VERSION is the scheduler version (FSRS parameter set) new students start on. Leave it at fsrs-6.0
# unless a new version has been shipped and replayed (docs/F-15-ROLLOUT.md, Rollback).
RECALL_DEFAULT_WEIGHTS_VERSION=fsrs-6.0

# F-03 R2 upload scanning. null = no scan, files are clean at once (development and tests ONLY). clamd = stream every upload to
# ClamAV (the scan runs in the worker as the media.scan job). Set CLAMD_SOCKET for a unix socket, or CLAMD_HOST and CLAMD_PORT.
# clamd.conf needs StreamMaxLength 64M so the largest plan file passes.
MEDIA_SCANNER=null
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_SOCKET=

# F-03 R2 worker container only (docs/F-03-WORKER.md). All optional.
# WORKER_TYPE_LIMITS=notes.ocr=1,notes.export_pdf=1   max running at once per job type, over every worker
# WORKER_SHUTDOWN_GRACE_SECONDS=60
# WORKER_HEARTBEAT_SECONDS=30
# WORKER_FONTS_DIR=/usr/share/fonts/truetype/artha   Noto fonts the PDF export embeds
# WORKER_LIVENESS_FILE=/tmp/worker-alive

# AI card suggestions (F-15 R2-W5). Needed by the API and by the worker. All fail closed.
# RECALL_AI_ENABLED is the kill switch. RECALL_AI_CONSENT_APPROVED must stay false until the owner has approved the notice in
# modules/recall/domain/ai_consent.py. RECALL_AI_DAILY_BUDGET_PAISE caps the total Gemini spend of all students per India day.
RECALL_AI_ENABLED=true
RECALL_AI_CONSENT_APPROVED=false
RECALL_AI_DAILY_BUDGET_PAISE=0
